# Force GitHub's language statistics analyzer to ignore web wrapper scaffolding
server.ts linguist-vendored
package.json linguist-vendored
package-lock.json linguist-vendored
tsconfig.json linguist-vendored
metadata.json linguist-vendored
firebase-blueprint.json linguist-vendored
firebase-applet-config.json linguist-vendored
firestore.rules linguist-vendored
.env.example linguist-vendored

# Treat the web preview source wrappers as vendored dependencies
web/** linguist-vendored

# Ensure Dart and Flutter code are recognized as the primary language in statistics
lib/**/*.dart linguist-detectable=true
pubspec.yaml linguist-detectable=true
