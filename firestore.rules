rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isAuthenticated() && 
        ((exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
         ((request.auth.token.email == "sarahothmanhussain783@gmail.com" || request.auth.token.email == "hudahussain258@gmail.com") && request.auth.token.email_verified == true));
    }
    function isCoach() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach';
    }
    function isParent() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'parent';
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'name', 'role']) &&
             data.uid is string &&
             data.email is string &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.role in ['player', 'coach', 'parent', 'admin'] &&
             (!('avatar' in data) || data.avatar is string) &&
             (!('createdAt' in data) || data.createdAt is string) &&
             (!('fcmToken' in data) || data.fcmToken is string) &&
             (!('onboardingCompleted' in data) || data.onboardingCompleted is bool) &&
             (!('sports' in data) || data.sports is list) &&
             (!('skillLevel' in data) || data.skillLevel is string) &&
             (!('parentId' in data) || data.parentId is string) &&
             (!('availability' in data) || data.availability is string);
    }

    function isValidFeedback(data) {
      return data.keys().hasAll(['userId', 'targetId', 'targetType', 'rating', 'createdAt']) &&
             data.userId is string &&
             data.targetId is string &&
             data.targetType in ['coach', 'session', 'player'] &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.createdAt is string &&
             (!('comment' in data) || data.comment is string);
    }

    function isValidSession(data) {
      return data.keys().hasAll(['coachId', 'coachName', 'title', 'sport', 'date', 'time', 'court', 'status', 'participants', 'maxParticipants']) &&
             data.coachId is string &&
             data.coachName is string &&
             data.title is string && data.title.size() > 0 && data.title.size() < 100 &&
             data.sport is string &&
             data.date is string &&
             data.time is string &&
             data.court is string &&
             data.status in ['scheduled', 'completed', 'cancelled'] &&
             data.participants is list &&
             data.maxParticipants is number;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /users/{userId} {
      // Allow any authenticated user to read profiles (needed for chat, search, etc.)
      allow read: if isAuthenticated();
      
      // Only owner can create their own profile
      allow create: if isAuthenticated() && request.auth.uid == userId && isValidUser(request.resource.data) && 
                    (request.resource.data.role != 'admin' || ((request.auth.token.email == "sarahothmanhussain783@gmail.com" || request.auth.token.email == "hudahussain258@gmail.com") && request.auth.token.email_verified == true));
      
      // Only owner or admin can update. Parents can update their children's parentId (for linking).
      allow update: if (isOwner(userId) && isValidUser(request.resource.data) && request.resource.data.role == resource.data.role) || 
                    (isParent() && resource.data.role == 'player' && request.resource.data.parentId == request.auth.uid) || 
                    isAdmin();
    }

    match /players/{userId} {
      allow read: if isOwner(userId) || isCoach() || isAdmin() || (isParent() && get(/databases/$(database)/documents/users/$(userId)).data.parentId == request.auth.uid);
      allow write: if isOwner(userId) || isCoach() || isAdmin();
    }

    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.childId == request.auth.uid || isAdmin() || (isParent() && get(/databases/$(database)/documents/users/$(resource.data.userId)).data.parentId == request.auth.uid));
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid || isAdmin();
    }

    match /match_requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid || isAdmin();
    }

    match /chats/{chatId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isAuthenticated() && request.auth.uid == request.resource.data.senderId && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    match /performance/{perfId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isCoach() || isAdmin() || (isParent() && get(/databases/$(database)/documents/users/$(resource.data.userId)).data.parentId == request.auth.uid));
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isCoach() || isAdmin());
    }

    match /ai_analysis/{analysisId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isCoach() || isAdmin() || (isParent() && get(/databases/$(database)/documents/users/$(resource.data.userId)).data.parentId == request.auth.uid));
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /feedback/{feedbackId} {
      allow read: if isAdmin() || (isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.targetId == request.auth.uid || (isParent() && get(/databases/$(database)/documents/users/$(resource.data.targetId)).data.parentId == request.auth.uid)));
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isValidFeedback(request.resource.data);
      allow update, delete: if isAdmin();
    }

    function isValidSessionUpdate(data, prevData) {
      // Players can only update participants
      let isPlayerUpdate = data.diff(prevData).affectedKeys().hasOnly(['participants']) &&
                           data.participants is list &&
                           data.participants.size() <= (prevData.maxParticipants || 20);
      
      // Coaches can update everything but coachId
      let isCoachUpdate = isAuthenticated() && 
                          request.auth.uid == prevData.coachId &&
                          data.coachId == prevData.coachId &&
                          isValidSession(data);
      
      return isPlayerUpdate || isCoachUpdate || isAdmin();
    }

    match /sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create: if isCoach() && request.resource.data.coachId == request.auth.uid && isValidSession(request.resource.data);
      allow update: if isValidSessionUpdate(request.resource.data, resource.data);
      allow delete: if (isCoach() && resource.data.coachId == request.auth.uid) || isAdmin();
    }

    match /clubs/{clubId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /training_plans/{planId} {
      allow read: if isAuthenticated() && (resource.data.coachId == request.auth.uid || isAdmin());
      allow create: if isCoach() && request.resource.data.coachId == request.auth.uid;
      allow update, delete: if isCoach() && resource.data.coachId == request.auth.uid || isAdmin();
    }
  }
}
